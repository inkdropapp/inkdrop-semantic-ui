/*******************************
         Site Overrides
*******************************/

.left.aligned {
  text-align: left;
}

.right.aligned {
  text-align: right;
}

.center.aligned {
  text-align: center;
}

.right.floated.text {
  float: right;
}

.left.floated.text {
  float: left;
}

a, a:active, a:focus {
  outline: none
}

.ui.button.gradation, .ui.disabled.button.gradation {
  font-family: 'proxima-soft', sans-serif;
  font-size: 16px;
  color: white;
  background: #3d7aed;
  background-image: linear-gradient(90deg,#66b6ea 0,#8743ff) !important;
  border-radius: 1.3em;
  box-shadow: 0 10px 30px 2px rgba(159,191,255,.4);
  mix-blend-mode: multiply;

  &:hover, &:active, &:focus {
    color: white;
    background: lighten(#1c6dff, 10%);
    background-image: linear-gradient(90deg, lighten(#66b6ea, 10%) 0, lighten(#8743ff, 10%));
    box-shadow: 0 10px 30px 2px rgba(159,191,255,.4);
  }
}

